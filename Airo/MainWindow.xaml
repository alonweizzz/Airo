<Window x:Class="Airo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Airo Beta 0.1" Height="700" Width="1040" MinWidth="740" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#080D1C" Foreground="White" FontFamily="Segoe UI">
 <Window.Resources>
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B03C557C" Offset="0"/><GradientStop Color="#A0283E65" Offset=".5"/><GradientStop Color="#C0172948" Offset="1"/></LinearGradientBrush>
  <Style x:Key="DockButton" TargetType="Button"><Setter Property="Width" Value="58"/><Setter Property="Height" Value="58"/><Setter Property="Margin" Value="5,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#C9E7FF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="19" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#654D83B6"/><Setter TargetName="Shell" Property="BorderBrush" Value="#809DE5FF"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#9072B6E6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DockIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="25"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid ClipToBounds="True">
  <Grid.Background><RadialGradientBrush Center=".22,.12" GradientOrigin=".22,.12" RadiusX="1.1" RadiusY="1.1"><GradientStop Color="#193B70" Offset="0"/><GradientStop Color="#0B1732" Offset=".45"/><GradientStop Color="#070C19" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Ellipse Width="420" Height="420" Fill="#1546A5EC" Opacity=".18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-180,0,0"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Ellipse Width="430" Height="380" Fill="#286B5DF4" Opacity=".12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-160"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Grid Margin="36,26,36,118">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="15" Background="#315BBAFF" BorderBrush="#789BE6FF" BorderThickness="1"><TextBlock Text="A" FontSize="29" FontWeight="Bold" Foreground="#E6FAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Airo" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="BETA 0.1  ·  SCREEN MIRRORING" FontSize="10" Foreground="#93B7DA" FontWeight="SemiBold"/></StackPanel></StackPanel><Border DockPanel.Dock="Right" CornerRadius="15" Background="#253A5575" Padding="15,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#FFDBA15A" Margin="0,0,9,0"/><TextBlock Text="Receiver offline" FontSize="12" Foreground="#CFDDF1"/></StackPanel></Border></DockPanel>
   <Border Grid.Row="1" Margin="0,26,0,0" CornerRadius="28" Background="#4A132745" BorderBrush="#456A95C3" BorderThickness="1">
    <Grid><Border Margin="10" CornerRadius="23" BorderBrush="#224F85B5" BorderThickness="1"/>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
      <Border Width="108" Height="108" CornerRadius="33" Background="#2A3A6792" BorderBrush="#5C6DAEDC" BorderThickness="1" Margin="0,0,0,24"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="49" Foreground="#70D9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Your screen. Beautifully mirrored." FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
      <TextBlock Text="The AirPlay receiver is not connected yet." FontSize="15" Foreground="#A9C1E0" Margin="0,12,0,0" TextAlignment="Center"/>
      <TextBlock Text="We're building the connection engine. For now, explore the new Airo interface using the floating dock below." FontSize="13" Foreground="#7F9FC4" TextWrapping="Wrap" Margin="20,18,20,0" TextAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28" CornerRadius="30" Background="#55000000" Padding="5"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="12" Opacity=".65"/></Border.Effect>
   <Border CornerRadius="26" Background="{StaticResource Glass}" BorderBrush="#8B99C7F0" BorderThickness="1" Padding="10,10">
    <StackPanel Orientation="Horizontal">
     <Button Style="{StaticResource DockButton}" Background="#65448DCA" ToolTip="Home" AutomationProperties.Name="Home" Click="Home_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE80F;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="Connect / Devices" AutomationProperties.Name="Devices" Click="Devices_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE8B7;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="Capture" AutomationProperties.Name="Capture" Click="Capture_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE722;"/></Button>
     <Border Width="1" Background="#628DB3DB" Margin="9,12"/>
     <Button Style="{StaticResource DockButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE713;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="About Airo" AutomationProperties.Name="About" Click="About_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE946;"/></Button>
    </StackPanel>
   </Border>
  </Border>
 </Grid>
</Window>