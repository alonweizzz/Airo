<Window x:Class="Airo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" Title="Airo Beta 0.4 — UI Preview" Height="760" Width="1100" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#080D1C" Foreground="White" FontFamily="Segoe UI">
 <Window.Resources>
  <!-- Layered translucent brushes emulate frosted glass without requiring DWM APIs. -->
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E33D608C" Offset="0"/><GradientStop Color="#DB233C63" Offset=".48"/><GradientStop Color="#E31B3052" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="StageGlass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B71B3B60" Offset="0"/><GradientStop Color="#B20B1A34" Offset="1"/></LinearGradientBrush>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="#354B729D"/><Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="BorderBrush" Value="#6B8EBD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionShell" Property="Background" Value="#5B4B91CE"/><Setter TargetName="ActionShell" Property="BorderBrush" Value="#A7D8FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionShell" Property="Background" Value="#8057B3E8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DockButton" TargetType="Button"><Setter Property="Width" Value="60"/><Setter Property="Height" Value="60"/><Setter Property="Margin" Value="5,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#C9E7FF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="19" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#654D83B6"/><Setter TargetName="Shell" Property="BorderBrush" Value="#809DE5FF"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#9072B6E6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DockIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="25"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid ClipToBounds="True">
  <Grid.Background><RadialGradientBrush Center=".22,.12" GradientOrigin=".22,.12" RadiusX="1.1" RadiusY="1.1"><GradientStop Color="#193B70" Offset="0"/><GradientStop Color="#0B1732" Offset=".45"/><GradientStop Color="#070C19" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Ellipse Width="420" Height="420" Fill="#1546A5EC" Opacity=".25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-180,0,0"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Ellipse Width="430" Height="380" Fill="#286B5DF4" Opacity=".12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-160"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Grid Margin="38,30,38,125">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><Border Width="56" Height="56" CornerRadius="28" Background="#172D4C" BorderBrush="#5C82B7" BorderThickness="1" ClipToBounds="True"><Grid><TextBlock x:Name="LogoFallback" Text="A" FontSize="29" FontWeight="Bold" Foreground="#E6FAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="BrandLogo" Stretch="UniformToFill" Width="56" Height="56" Visibility="Collapsed"><Image.Clip><EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/></Image.Clip></Image></Grid></Border><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Airo" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="BETA 0.4  /  DESIGN PREVIEW" FontSize="10" Foreground="#93B7DA" FontWeight="SemiBold"/></StackPanel></StackPanel><Border DockPanel.Dock="Right" CornerRadius="16" Background="{StaticResource Glass}" BorderBrush="#668AB6" BorderThickness="1" Padding="16,11" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ReceiverDot" Width="8" Height="8" Fill="#FFDBA15A" Margin="0,0,9,0"/><TextBlock x:Name="ReceiverStatus" Text="Receiver offline" FontSize="12" Foreground="#CFDDF1"/></StackPanel></Border><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Button Style="{StaticResource ActionButton}" Click="VideoLayout_Click" ToolTip="Switch portrait / landscape (F6)" Content="&#x21C4;  Layout"/><Button Style="{StaticResource ActionButton}" Click="RefreshVideo_Click" ToolTip="Refresh the video viewport if it appears black (F7)" Content="&#x21BB;  Refresh"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Margin="0,26,0,0" CornerRadius="30" Background="{StaticResource StageGlass}" BorderBrush="#7897C6" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#020714" BlurRadius="28" ShadowDepth="9" Opacity=".4"/></Border.Effect>
    <Grid x:Name="DisplaySurface"><Border Margin="9" CornerRadius="24" BorderBrush="#46668DB8" BorderThickness="1"/>
     <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,24,0,0" Background="#70345276" BorderBrush="#7296C4" BorderThickness="1" CornerRadius="11" Padding="11,7" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#6DCAFF" Margin="0,0,7,0"/><TextBlock Text="LIVE VIEWPORT" FontSize="10" FontWeight="SemiBold" Foreground="#D8ECFF"/></StackPanel>
     </Border>
     <wfi:WindowsFormsHost x:Name="VideoHost" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
      <Border Width="108" Height="108" CornerRadius="33" Background="#2A3A6792" BorderBrush="#5C6DAEDC" BorderThickness="1" Margin="0,0,0,24"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="49" Foreground="#70D9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Your screen, in focus." FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
      <TextBlock Text="Connect your iPhone to bring your screen to life." FontSize="15" Foreground="#A9C1E0" Margin="0,12,0,0" TextAlignment="Center"/>
      <TextBlock Text="Open Devices below to start the receiver. Your mirrored screen will appear here." FontSize="13" Foreground="#7F9FC4" TextWrapping="Wrap" Margin="20,18,20,0" TextAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,25" CornerRadius="32" Background="#33030C1C" Padding="5"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity=".52"/></Border.Effect>
   <Border CornerRadius="28" Background="{StaticResource Glass}" BorderBrush="#91B7E0" BorderThickness="1" Padding="22,11">
    <StackPanel Orientation="Horizontal">
     <Button Style="{StaticResource DockButton}" Background="#65448DCA" ToolTip="Home" AutomationProperties.Name="Home" Click="Home_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE80F;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="Connect / Devices" AutomationProperties.Name="Devices" Click="Devices_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE8B7;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="Capture" AutomationProperties.Name="Capture" Click="Capture_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE722;"/></Button>
     <Border Width="1" Background="#628DB3DB" Margin="16,12"/>
     <Button Style="{StaticResource DockButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE713;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="About Airo" AutomationProperties.Name="About" Click="About_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE946;"/></Button>
    </StackPanel>
   </Border>
  </Border>
 </Grid>
</Window>