<Window x:Class="Airo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" Title="Airo Beta 0.2" Height="700" Width="1040" MinWidth="740" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#080D1C" Foreground="White" FontFamily="Segoe UI">
 <Window.Resources>
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A0354C6D" Offset="0"/><GradientStop Color="#98263858" Offset=".5"/><GradientStop Color="#A91A2944" Offset="1"/></LinearGradientBrush>
  <Style x:Key="DockButton" TargetType="Button"><Setter Property="Width" Value="58"/><Setter Property="Height" Value="58"/><Setter Property="Margin" Value="5,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#C9E7FF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="20" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#654D83B6"/><Setter TargetName="Shell" Property="BorderBrush" Value="#809DE5FF"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#9072B6E6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DockIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="25"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid ClipToBounds="True">
  <Grid.Background><RadialGradientBrush Center=".22,.12" GradientOrigin=".22,.12" RadiusX="1.1" RadiusY="1.1"><GradientStop Color="#193B70" Offset="0"/><GradientStop Color="#0B1732" Offset=".45"/><GradientStop Color="#070C19" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Ellipse Width="420" Height="420" Fill="#1546A5EC" Opacity=".18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-180,0,0"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Ellipse Width="430" Height="380" Fill="#286B5DF4" Opacity=".12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-160"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Grid Margin="36,26,36,118">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><Border Width="56" Height="56" CornerRadius="28" Background="#172D4C" BorderBrush="#5C82B7" BorderThickness="1" ClipToBounds="True"><Grid><TextBlock x:Name="LogoFallback" Text="A" FontSize="29" FontWeight="Bold" Foreground="#E6FAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="BrandLogo" Stretch="UniformToFill" Width="56" Height="56" Visibility="Collapsed"><Image.Clip><EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/></Image.Clip></Image></Grid></Border><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Airo" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="BETA 0.2  ·  SCREEN MIRRORING" FontSize="10" Foreground="#93B7DA" FontWeight="SemiBold"/></StackPanel></StackPanel><Border DockPanel.Dock="Right" CornerRadius="15" Background="#253A5575" Padding="15,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ReceiverDot" Width="8" Height="8" Fill="#FFDBA15A" Margin="0,0,9,0"/><TextBlock x:Name="ReceiverStatus" Text="Receiver offline" FontSize="12" Foreground="#CFDDF1"/></StackPanel></Border></DockPanel>
   <Border Grid.Row="1" Margin="0,26,0,0" CornerRadius="28" Background="#4A132745" BorderBrush="#456A95C3" BorderThickness="1">
    <Grid><Border Margin="10" CornerRadius="23" BorderBrush="#224F85B5" BorderThickness="1"/>
     <wfi:WindowsFormsHost x:Name="VideoHost" Visibility="Collapsed" Margin="12"/><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
      <Border Width="108" Height="108" CornerRadius="33" Background="#2A3A6792" BorderBrush="#5C6DAEDC" BorderThickness="1" Margin="0,0,0,24"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="49" Foreground="#70D9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Your screen. Beautifully mirrored." FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
      <TextBlock Text="Use Devices to start your saved UxPlay receiver." FontSize="15" Foreground="#A9C1E0" Margin="0,12,0,0" TextAlignment="Center"/>
      <TextBlock Text="Experimental window embedding: the receiver may appear here once its video window opens." FontSize="13" Foreground="#7F9FC4" TextWrapping="Wrap" Margin="20,18,20,0" TextAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22" CornerRadius="30" Background="#22000000" Padding="3"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="7" Opacity=".35"/></Border.Effect>
   <Border CornerRadius="26" Background="{StaticResource Glass}" BorderBrush="#6586ADD0" BorderThickness="1" Padding="24,10">
    <StackPanel Orientation="Horizontal">
     <Button Style="{StaticResource DockButton}" Background="#65448DCA" ToolTip="Home" AutomationProperties.Name="Home" Click="Home_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE80F;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="Connect / Devices" AutomationProperties.Name="Devices" Click="Devices_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE8B7;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="Capture" AutomationProperties.Name="Capture" Click="Capture_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE722;"/></Button>
     <Border Width="1" Background="#628DB3DB" Margin="16,12"/>
     <Button Style="{StaticResource DockButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE713;"/></Button>
     <Button Style="{StaticResource DockButton}" ToolTip="About Airo" AutomationProperties.Name="About" Click="About_Click"><TextBlock Style="{StaticResource DockIcon}" Text="&#xE946;"/></Button>
    </StackPanel>
   </Border>
  </Border>
 </Grid>
</Window>